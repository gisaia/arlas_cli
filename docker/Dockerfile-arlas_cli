FROM python:3.12-slim


WORKDIR /app

COPY arlas/ ./arlas/
COPY pyproject.toml .
COPY setup.cfg .
COPY requirements.txt .
COPY README-ARLAS-CLI-COMMANDS.md .

# Install arlas_cli
# Create a default "local" config in order to run documentation generation
# WITHOUT the "Warning : no configuration available"
RUN pip3 install --require-hashes --only-binary :all: "arlas_cli@file:///app/" && arlas_cli confs create local --server http://localhost/arlas
